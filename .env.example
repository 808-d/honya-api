# Copy to .env and fill in your own values. .env is gitignored.
APP_NAME=honya-api
APP_ENV=development
PORT=8080

DATABASE_URL=postgres://postgres:123@localhost:5432/honya?sslmode=disable

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Gmail transactional mail. Leave both empty to log emails instead of sending.
# APP_PASSWORD is a Google app password (requires 2FA on the account).
SMTP_EMAIL=
APP_PASSWORD=

# Frontend base URLs used to build the links inside emails.
APP_BASE_URL=http://localhost:5173
WEB_BASE_URL=http://localhost:5173

# How long email verification / password reset links stay valid.
VERIFICATION_TTL_MINUTES=30
